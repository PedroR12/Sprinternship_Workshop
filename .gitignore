# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.fuse_hidden
*.swp
*~
.trash/

# ==========================================
# IDEs and Editors
# ==========================================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA (PyCharm, WebStorm, Android Studio, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-v][a-z]
[._]sw[a-p]

# ==========================================
# Common Logs & Temps
# ==========================================
*.log
*.tmp
*.bak
*.swp
.cache/
.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Build & Dependency Directories (Commonly Ignored)
# ==========================================
node_modules/
bower_components/
vendor/
__pycache__/
*.py[cod]
bin/
obj/
dist/
build/
target/

# ==========================================
# Security & Secrets (NEVER COMMIT THESE)
# ==========================================
.env
.env.local
.env.*.local
*.key
*.pem
secrets.json
credentials.json
